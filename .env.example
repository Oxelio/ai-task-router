# Hosted TypeSafe / Jev API example (provide your real key):
TYPESAFE_API_KEY=replace_me
TYPESAFE_MODEL=jev-latest

# Local Kev via Ollama: override the values above (no hosted key required):
# TYPESAFE_API_KEY=local
# TYPESAFE_BASE_URL=http://127.0.0.1:11434
# TYPESAFE_MODEL=kev:4b-q4_K_M

# Execution model catalog (recommended models are not called by this CLI)
MODEL_REGISTRY_PATH=models.json
